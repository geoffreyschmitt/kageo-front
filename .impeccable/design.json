  "narrative": {
    "northStar": "The Wrapped Gift",
    "overview": "Kageo looks like something carefully wrapped: a calm paper ground, one ribbon of sage green, and a serif voice that feels hand-lettered rather than corporate. The interface is discreet by design, because the product's promise is a surprise kept intact.",
    "keyCharacteristics": [
      "Paper-warm neutrals with a single sage accent, used for action and \"done\".",
      "Fraunces for display voice, DM Sans for everything functional.",
      "Pill-shaped controls inside softly rounded cards.",
      "Warm, brown-tinted shadows; cards lift on hover.",
      "Status carried by tinted chips with paired foreground/background colors, never colour alone."
    ],
    "rules": [
      {
        "name": "The One Ribbon Rule",
        "body": "Sage is the only chromatic accent for action. Status colours label state; they never decorate or act as buttons.",
        "section": "colors"
      },
      {
        "name": "The Warm Neutral Rule",
        "body": "Every neutral leans brown (hue ~60-80). No cool greys, no pure black text, no pure black shadows in light mode.",
        "section": "colors"
      },
      {
        "name": "The Paired Status Rule",
        "body": "A status colour is always a foreground on its own tint, with an icon or label. Colour never carries meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Serif Is a Voice Rule",
        "body": "Fraunces is for names, titles and moments of warmth. Forms, buttons, metadata and tables are always DM Sans.",
        "section": "typography"
      },
      {
        "name": "The Cormorant Is Dead Rule",
        "body": "Never reintroduce Cormorant Garamond; the CSS variable name is historical only.",
        "section": "typography"
      },
      {
        "name": "The Lift-On-Interest Rule",
        "body": "Elevation increases only in response to hover or focus; at rest everything stays calm.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Use Sage Ribbon (#3f6845) as the only action colour.",
      "Read colours through the semantic tokens in theme.css so light and dark both resolve.",
      "Make every control a pill and every container softly rounded (10 / 16 / 20px).",
      "Keep the shared list readable on a phone with no account.",
      "Pair status colours with an icon or label."
    ],
    "donts": [
      "Don't reintroduce Cormorant Garamond or use Fraunces for form controls.",
      "Don't use cool greys, pure black text or neutral black shadows in light mode.",
      "Don't hard-code hex values in components; use the theme tokens.",
      "Don't show reservations, pots or guest comments in any owner view.",
      "Don't signal state by colour alone."
    ]
  }
}