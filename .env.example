# Copy to .env.local and fill in. See docs/architecture.md#environment.
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Vercel KV (Upstash Redis): use a development database, not production
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Reserved for invite emails (not used yet)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: used when building share URLs
NEXT_PUBLIC_APP_URL=

# Privacy page (/privacy): contact shown on it, and 1 once a lawyer has reviewed the text
# (removes the "draft" notice).
NEXT_PUBLIC_PRIVACY_CONTACT=
NEXT_PUBLIC_PRIVACY_REVIEWED=
